  "main": "server.js",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/output.css --watch",
    "dev:server": "node --watch server.js",
    "dev": "concurrently \"npm:watch:css\" \"npm:dev:server\"",
    "start": "npm run build:css && node server.js"
  },
